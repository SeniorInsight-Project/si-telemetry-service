# Copie para .env e preencha. O .env não é versionado.

# PostgreSQL (o Flyway cria o schema "telemetry" se ele não existir)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=telemetry
DB_PASSWORD=

# RabbitMQ (o serviço declara a exchange topic "si.events" e a fila "telemetry.q" com dead-letter)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=telemetry
RABBITMQ_PASSWORD=

# Keycloak: precisa ser igual ao claim "iss" dos tokens
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight
# Opcional: de onde baixar as chaves públicas quando o issuer não é acessível pelo serviço (ex.: dentro do Docker)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://keycloak:8080/realms/seniorinsight/protocol/openid-connect/certs

# Open Wearables (self-hosted). A chave vai no header X-Open-Wearables-API-Key.
OPENWEARABLES_ENABLED=false
OPENWEARABLES_BASE_URL=http://localhost:8000
OPENWEARABLES_API_KEY=

# care-service: endpoint interno de vínculo (RF-007)
CARE_SERVICE_URL=http://localhost:8082

# Porta HTTP do serviço
SERVER_PORT=8080
